# FortiAIGate + lab live-test credentials. Copy to `.env` (same directory)
# and fill in. `.env` is gitignored - never commit real credentials.

# --- FortiAIGate management API ---
FAIG_MGMT_URL=https://fortiaigate.example.com
FAIG_ADMIN_USER=admin@example.com
FAIG_ADMIN_PASS=your-admin-password

# Optional data-plane URL override (use when the management and data-plane
# hosts differ, e.g. a tunneled endpoint):
# FAIG_API_URL=

# --- A live virtual key the live tests may verify (read-only probe) ---
# Mutating live tests (create/rotate/revoke) are opt-in via FAIG_ALLOW_MUTATE.
FAIG_LAB_API_KEY=

# --- FortiSOAR appliance - connector install, config, playbook push ---
FSR_BASE_URL=https://fortisoar.example.com:13000
FSR_USERNAME=csadmin
FSR_PASSWORD=<your-password>
FSR_VERIFY_SSL=false

# --- HashiCorp Vault (workstation path; on-fabric config notes below) ---
# VAULT_INTERNAL_ADDR is what the on-appliance connector configuration uses
# (the Vault server as reachable from the FortiSOAR appliance).
VAULT_ADDR=https://fortisoar.example.com:16001
VAULT_TOKEN=<your-token>
VAULT_SECRET_PATH=secret/myapp/api
VAULT_INTERNAL_ADDR=http://10.0.0.1:8200
