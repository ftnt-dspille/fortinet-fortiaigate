        {
          "@type": "Workflow",
          "name": "Heal Expired FortiAIGate Key in Vault",
          "aliasName": null,
          "tag": "",
          "recordTags": [],
          "description": "Rotation flow for FortiAIGate virtual keys: reads the current api_key from a HashiCorp Vault KV v2 secret, derives the gateway key id from the key itself (a virtual key embeds its record id), and validates the key against the data plane. If the key is expired, revoked or suspended (the models endpoint rejects it), the key is ROTATED on FortiAIGate (old secret invalidated, new secret issued for the same key id), the new secret is written to Vault as a new KV version - all other fields of the secret are preserved - and the new key is verified end-to-end. If the key is already valid, nothing happens.",
          "isActive": true,
          "debug": false,
          "singleRecordExecution": false,
          "remoteExecutableFlag": 0,
          "parameters": [
            "secret_path"
          ],
          "synchronous": false,
