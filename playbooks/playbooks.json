        {
          "@type": "Workflow",
          "name": "Heal Expired FortiAIGate Key in Vault",
          "aliasName": null,
          "tag": "",
          "recordTags": [],
          "description": "Keeps an application's FortiAIGate virtual key working. Reads the key from a HashiCorp Vault KV v2 secret and tests it against the data plane. If it no longer works (expired, revoked or suspended), the playbook issues a replacement - FortiAIGate cannot rotate a key in that state, so it creates a new key in the same workspace with the same name, limits and policies - writes the new secret into the same Vault path as a new version, and checks that the new key works. Every other field of the secret is kept. A key that still works is left alone. A key that was revoked on purpose, or that has model groups or provider access (which a replacement would not inherit), stops the run with a message instead.\nInputs: secret_path (the KV v2 path, for example lab/ai) and, when the key is not stored under api_key, key_field. Outputs: rotation_result (a one-line outcome), rotated (true or false), new_key_id and key_method (reissued or rotated). Run it from a schedule, or call it as a child playbook once per secret.",
          "isActive": true,
          "debug": false,
          "singleRecordExecution": false,
          "remoteExecutableFlag": 0,
          "parameters": [
            "secret_path",
            "key_field"
          ],
          "synchronous": false,
          "lastModifyDate": 1791925194,
          "collection": "/api/3/workflow_collections/fef97bfb-4dd3-5260-919d-7119a9d18e0a",
